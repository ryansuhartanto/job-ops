{
  "name": "job-ops",
  "private": true,
  "workspaces": [
    "orchestrator",
    "docs-site",
    "career-boards/*",
    "extractors/*",
    "shared"
  ],
  "scripts": {
    "test:all": "bun run --filter ./orchestrator test:run",
    "check:types:shared": "bun run --filter ./shared check:types",
    "check:types": "bun run --filter ./shared check:types && bun run --filter ./orchestrator check:types",
    "check:types:ukvisajobs": "bun run --filter ukvisajobs-extractor check:types",
    "check:all": "bun --bun ./orchestrator/node_modules/.bin/biome ci .",
    "format:all": "bun --bun ./orchestrator/node_modules/.bin/biome format . --write",
    "check:types:gradcracker": "bun run --filter gradcracker-extractor check:types",
    "docs:dev": "bun run --filter ./docs-site start",
    "docs:build": "bun run --filter ./docs-site build",
    "check:docs": "bun run --filter ./docs-site build",
    "docs:serve": "bun run --filter ./docs-site serve",
    "docs:version": "bun run --filter ./docs-site docs:version",
    "typst-theme:generate": "bun ./scripts/generate-typst-themes.mjs",
    "typst-theme:validate": "bun ./scripts/generate-typst-themes.mjs --check && bun run --filter ./orchestrator test:run src/server/services/resume-renderer/typst.test.ts",
    "release:set-version": "bun ./scripts/set-orchestrator-version.mjs",
    "knip": "bun --bun knip"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "knip": "^5.83.1",
    "typescript": "^5.9.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.5",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "fflate": "^0.8.3"
  }
}
